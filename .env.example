# Provider credentials. Copy to .env for local mode and fill these values.
GOOGLE_API_KEY=
# Required instead of GOOGLE_API_KEY when KASSETTE_TRANSCRIPTION_PROVIDER=openai.
# OPENAI_API_KEY=
FISH_API_KEY=

# Cascaded voice is the default. Quicksilver and Gemini Live use native audio
# and delegate every substantive request back to the active client.
KASSETTE_VOICE_BACKEND=cascade
# Set to gemini-live for delegated Gemini Live audio.
KASSETTE_GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: only applies to gemini-3.8-live-extended-thinking.
# KASSETTE_GEMINI_LIVE_THINKING_LEVEL=high
# Use "openai" for GPT Live Transcribe. Gemini remains the default.
KASSETTE_TRANSCRIPTION_PROVIDER=gemini
KASSETTE_OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Silence required to finalize an utterance. Raise this if normal pauses split speech.
KASSETTE_VAD_STOP_SECS=1.8
# Local PipeWire/Pulse microphones are quieter than browser WebRTC streams.
KASSETTE_VAD_MIN_VOLUME=0.1
# Optional stable PyAudio device names for terminal clients. Prefer names because
# numeric indexes can change when PipeWire devices are added or removed.
# KASSETTE_INPUT_DEVICE_NAME=pulse
# KASSETTE_OUTPUT_DEVICE_NAME=pulse
# Numeric fallbacks remain available for systems without stable names.
# KASSETTE_INPUT_DEVICE_INDEX=0
# KASSETTE_OUTPUT_DEVICE_INDEX=0
# Optional versioned JSON profile for post-STT, pre-event transcript grooming.
# The default is no-op. Keep personal profiles outside the repository.
# KASSETTE_TRANSCRIPT_GROOMING_PROFILE=/home/you/.config/kassette/transcript-grooming.json
KASSETTE_TRANSCRIPT_GROOMING_TIMEOUT_SECS=0.5
FISH_MODEL=s2.1-pro
# Optional Fish Audio reference/voice ID. The account default is used when omitted.
# FISH_VOICE_ID=

# Hosted mode is enabled by `kassette serve --hosted`. Railway supplies PORT.
# Keep the service secret separate from every provider credential.
# PORT=7860
# KASSETTE_SERVICE_SECRET=replace-with-at-least-32-random-characters
# Use managed TURN. `turns:` over TCP/TLS port 443 is the expected Railway shape.
# KASSETTE_ICE_SERVERS=[{"urls":"turns:turn.example.net:443?transport=tcp","username":"...","credential":"..."}]

# Required only by scripts/compare_tts.py.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
