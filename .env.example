# Local provider credentials. Copy to .env and fill these values.
GOOGLE_API_KEY=
FISH_API_KEY=

# Cascaded voice is the default. Set quicksilver only for the legacy GPT-Live path.
KASSETTE_VOICE_BACKEND=cascade
# Silence required to finalize an utterance. Raise this if normal pauses split speech.
KASSETTE_VAD_STOP_SECS=1.8
# Optional versioned JSON profile for post-STT, pre-event transcript grooming.
# The default is no-op. Keep personal profiles outside the repository.
# KASSETTE_TRANSCRIPT_GROOMING_PROFILE=/home/you/.config/kassette/transcript-grooming.json
KASSETTE_TRANSCRIPT_GROOMING_TIMEOUT_SECS=0.5
FISH_MODEL=s2.1-pro
# Optional Fish Audio reference/voice ID. The account default is used when omitted.
# FISH_VOICE_ID=

# Required only by scripts/compare_tts.py.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
